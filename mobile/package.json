{
  "name": "@aside/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "check": "tsc --noEmit",
    "ios": "APP_VARIANT=local expo run:ios --configuration Release",
    "android": "node scripts/android-release.mjs",
    "ios:device": "APP_VARIANT=local expo run:ios --device --configuration Release",
    "build:internal": "npx --yes eas-cli@16.32.0 build --platform ios --profile internal",
    "build:testflight": "npx --yes eas-cli@16.32.0 build --platform ios --profile testflight",
    "submit:testflight": "npx --yes eas-cli@16.32.0 submit --platform ios --profile testflight",
    "build:apk": "npx --yes eas-cli@16.32.0 build --platform android --profile internal",
    "build:apk:local": "node scripts/android-release.mjs",
    "test:server": "cd .. && node --import tsx mobile/tests/server.mjs"
  },
  "dependencies": {
    "@aside/engine": "*",
    "@aside/player-runtime": "*",
    "@config-plugins/react-native-webrtc": "13.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "expo": "~54.0.0",
    "expo-audio": "~1.1.1",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-localization": "~17.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webrtc": "124.0.8",
    "zod": "^4.0.0",
    "@expo/vector-icons": "^15.1.1",
    "expo-font": "~14.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "^5.9.0"
  }
}
