OPENAI_API_KEY=
PORT=4310
ASIDE_DATA_DIR=
ASIDE_BACKEND_MODEL=gpt-5.6-luna

# Microphone detection: linear RMS (0.001–1), lower is more sensitive.
ASIDE_MIC_THRESHOLD=0.025
# Continuous above-threshold duration before interruption (40–2000 ms).
ASIDE_MIC_MIN_SPEECH_MS=120
# Below-threshold duration to consider speech ended (100–5000 ms).
ASIDE_MIC_SILENCE_MS=650

# Local audio retained before speech trigger (200–3000 ms).
ASIDE_MIC_PRE_ROLL_MS=750
# Keep Live briefly after podcast resumes (0–60000 ms).
ASIDE_LIVE_GRACE_MS=5000
# Close idle Live while leaving local mic armed (10000–300000 ms).
ASIDE_LIVE_IDLE_CLOSE_MS=60000

# Application cap for authenticated sessions (and the trusted local server).
# Guests remain at 120 seconds. Unset retains the legacy 120-second cap.
ASIDE_LIVE_ACCOUNT_SESSION_SECONDS=1800

# 回答音频结束后等待追问；0 禁用自动续播
ASIDE_AUTO_RESUME_MS=3000

# 本地人声检测；概率阈值越高越不容易误触发
ASIDE_MIC_VAD_ENABLED=true
ASIDE_MIC_VAD_THRESHOLD=0.8

# VAD 模式仅用低音量底线过滤近乎静音，不复用旧音量触发阈值
ASIDE_MIC_VAD_MIN_RMS=0.003

# Admin key for /api/admin/usage. Same value as the Worker secret ADMIN_KEY.
# Generate with: openssl rand -base64 32
ASIDE_ADMIN_KEY=
